{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 22, "patch": 0},
  "configurePresets": [
    {
      "name": "core-tests",
      "displayName": "Core tests without OBS SDK",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/core-tests",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "DIBU_BUILD_PLUGIN": "OFF", "DIBU_BUILD_TESTS": "ON"}
    },
    {"name": "template", "hidden": true, "cacheVariables": {"DIBU_BUILD_PLUGIN": true, "DIBU_BUILD_TESTS": true}},
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {"QT_VERSION": "6", "CMAKE_SYSTEM_VERSION": "10.0.18363.657"}
    },
    {
      "name": "windows-ci-x64",
      "displayName": "Windows x64 CI",
      "inherits": ["windows-x64"],
      "cacheVariables": {"CMAKE_COMPILE_WARNING_AS_ERROR": true}
    },
    {
      "name": "ubuntu-x86_64",
      "displayName": "Linux x86_64",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build_x86_64",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "generator": "Ninja",
      "cacheVariables": {"QT_VERSION": "6", "CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {"name": "ubuntu-ci-x86_64", "displayName": "Linux x86_64 CI", "inherits": ["ubuntu-x86_64"]},
    {
      "name": "macos",
      "displayName": "macOS Universal",
      "inherits": ["template"],
      "binaryDir": "${sourceDir}/build_macos",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "generator": "Xcode",
      "cacheVariables": {"QT_VERSION": "6", "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"}
    },
    {"name": "macos-ci", "displayName": "macOS Universal CI", "inherits": ["macos"]}
  ],
  "buildPresets": [
    {"name": "core-tests", "configurePreset": "core-tests"},
    {"name": "windows-x64", "configurePreset": "windows-x64", "configuration": "RelWithDebInfo"},
    {"name": "windows-ci-x64", "configurePreset": "windows-ci-x64", "configuration": "RelWithDebInfo"},
    {"name": "ubuntu-x86_64", "configurePreset": "ubuntu-x86_64", "configuration": "RelWithDebInfo"},
    {"name": "ubuntu-ci-x86_64", "configurePreset": "ubuntu-ci-x86_64", "configuration": "RelWithDebInfo"},
    {"name": "macos", "configurePreset": "macos", "configuration": "Release"},
    {"name": "macos-ci", "configurePreset": "macos-ci", "configuration": "RelWithDebInfo"}
  ],
  "testPresets": [{"name": "core-tests", "configurePreset": "core-tests", "output": {"outputOnFailure": true}}]
}
